<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="replace" />

    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>

    <application
        android:name="com.find.phone.gps.location.tracker.TrackerPhoneApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GpsTracker">

        <activity
            android:name="com.find.phone.gps.location.tracker.helpers.FaultRecoveryActivity"
            android:process=":crash_restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".crash_restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.boot.BootActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GpsTracker.Boot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.locale.LocalePickActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.consent.PolicyConsentActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.consent.OverlayConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.monetize.render.TipSheetActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:name="com.find.phone.gps.location.tracker.setupflow.HomeRoleTipActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.walkthrough.GuidedTourActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.MainHubActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.people.PeopleSelectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.find.phone.gps.location.tracker.screens.dashboard.PastLookupsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.simcard.OwnNumberActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.simcard.SendNumberActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.simcard.TwinSimOverviewActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.simcard.OperatorDialCodesActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.finder.NumberInsightActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.finder.PinpointingActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.screens.finder.MapExpandedActivity"
            android:exported="false" />

        <activity
            android:name="io.homedeck.grid.screens.HomeDeskPane"
            android:windowSoftInputMode="adjustNothing"
            tools:node="merge">
            
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.find.phone.gps.location.tracker.HomeEntry"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="io.homedeck.grid.screens.HomeDeskPane">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.find.phone.gps.location.tracker.setupflow.WelcomeStageActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name="com.find.phone.gps.location.tracker.setupflow.HomeRoleStageActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name="com.find.phone.gps.location.tracker.monetize.render.SponsorBrowserActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PromoWeb" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.find.phone.gps.location.tracker.monetize.render.MonetizeGateActivity"
            android:exported="false" />

        <activity
            android:name="com.find.phone.gps.location.tracker.screens.appevent.InstallOutcomeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="" />

        <activity
            android:name="com.find.phone.gps.location.tracker.screens.battery.PowerStateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Charging"
            android:turnScreenOn="true" />

        <service
            android:name="com.find.phone.gps.location.tracker.screens.consent.OverlayMonitorService"
            android:exported="false" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name="com.find.phone.gps.location.tracker.screens.alerts.AlarmListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.find.phone.gps.location.tracker.setupflow.AlarmIntroActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name="com.find.phone.gps.location.tracker.screens.alerts.AlarmPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ReminderAlert"
            android:turnScreenOn="true" />

        <service
            android:name="com.find.phone.gps.location.tracker.alarms.gate.AlarmGrantObserver"
            android:exported="false" />

    </application>

</manifest>
