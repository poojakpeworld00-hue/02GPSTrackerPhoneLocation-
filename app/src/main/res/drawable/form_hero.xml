<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#26A69A"
                android:endColor="#00695C" />
            <corners
                android:bottomLeftRadius="@dimen/_36sdp"
                android:bottomRightRadius="@dimen/_36sdp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.12"
                android:gradientRadius="75%p"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:bottomLeftRadius="@dimen/_36sdp"
                android:bottomRightRadius="@dimen/_36sdp" />
        </shape>
    </item>
</layer-list>
