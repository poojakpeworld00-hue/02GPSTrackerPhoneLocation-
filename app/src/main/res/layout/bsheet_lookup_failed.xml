<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vs_sheet_top_r30"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:background="@drawable/vs_handle_r3" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/vs_circle_danger_soft">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/vs_ic_alert_circle"
            app:tint="@color/ds_danger" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.02"
        android:text="@string/ds_lookup_failed_title"
        android:textColor="@color/ds_ink"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/lblBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/ds_lookup_failed_body"
        android:textColor="@color/ds_muted"
        android:textSize="14sp"
        tools:text="We couldn’t reach the location service. Please check your connection and try again." />

    <TextView
        android:id="@+id/padRetry"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/vs_btn_primary_selector_r16"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:text="@string/ds_lookup_failed_retry"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/padCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/figtree_semibold"
        android:padding="6dp"
        android:text="@string/ds_lookup_failed_cancel"
        android:textColor="@color/ds_primary"
        android:textSize="14sp" />
</LinearLayout>
