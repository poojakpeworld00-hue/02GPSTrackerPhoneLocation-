<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vs_sheet_top_r30"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:background="@drawable/vs_handle_r3" />

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="18dp">

        <com.find.phone.gps.location.tracker.screens.dashboard.AllowanceDialView
            android:id="@+id/ringVw"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink"
                android:textSize="24sp"
                tools:text="3/3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/ds_limit_used"
                android:textColor="@color/ds_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="@string/ds_limit_title"
        android:textColor="@color/ds_ink"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/lblBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/ds_muted"
        android:textSize="14sp"
        tools:text="You've used today's 3 free searches. More will unlock when the timer ends." />

    <LinearLayout
        android:id="@+id/countdownBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/vs_card_border_r18"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:letterSpacing="0.04"
            android:text="@string/ds_limit_timer_label"
            android:textAllCaps="true"
            android:textColor="@color/ds_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lblCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:textColor="@color/ds_primary"
            android:textSize="34sp"
            tools:text="59:59" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/figtree_medium"
        android:gravity="center"
        android:text="@string/ds_limit_reset"
        android:textColor="@color/ds_muted"
        android:textSize="12sp" />
</LinearLayout>
