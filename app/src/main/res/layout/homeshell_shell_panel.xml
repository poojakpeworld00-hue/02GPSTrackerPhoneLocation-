<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/panelDrawerVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas">

        <FrameLayout
            android:id="@+id/panelHolderVw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/panelContentVw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:layout="@layout/pane_home_core" />
        </FrameLayout>

        <include
            android:id="@+id/drawerMenuVw"
            layout="@layout/part_home_drawer"
            android:layout_width="296dp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
