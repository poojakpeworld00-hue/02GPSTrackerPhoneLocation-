<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetRootVw"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gp_bg_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/gp_bg_grabber" />

    <!-- segmented progress + skip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/segVw"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/padSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="@string/ps_skip"
            android:textColor="@color/ps_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- hero (per permission) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerVw"
        android:layout_width="match_parent"
        android:layout_height="206dp"
        android:layout_marginTop="14dp" />

    <!-- step rail -->
    <LinearLayout
        android:id="@+id/railVw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/lblTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.01"
        android:textColor="@color/ps_ink"
        android:textSize="23sp"
        tools:text="Enable notifications" />

    <TextView
        android:id="@+id/lblBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/figtree_regular"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ps_muted"
        android:textSize="14sp"
        tools:text="Be alerted when a lookup completes or a saved number changes. No promo spam." />

    <!-- primary -->
    <FrameLayout
        android:id="@+id/padPrimary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/gp_bg_btn_gradient"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/primaryContentVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pbPrimaryVw"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="9dp"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/picPrimary"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/gp_ic_check"
                app:tint="@android:color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                tools:text="Allow notifications" />
        </LinearLayout>
    </FrameLayout>

    <!-- trust line -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/gp_ic_lock"
            app:tint="@color/ps_dot_past" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_medium"
            android:text="@string/ps_trust"
            android:textColor="@color/ps_dot_past"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
