<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/mainVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        tools:context=".ui.MainHubActivity">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/homeContainerVw"
            android:name="com.find.phone.gps.location.tracker.screens.dashboard.DashboardMainFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/pane_home_core" />

        <include
            android:id="@+id/drawerMenuVw"
            layout="@layout/part_home_drawer"
            android:layout_width="296dp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
