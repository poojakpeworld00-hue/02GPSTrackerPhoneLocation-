<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/premiumRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface"
        android:orientation="vertical"
        tools:context=".ui.premium.ProUpgradeActivity">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/heroVw"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:clipChildren="true">

                    <com.find.phone.gps.location.tracker.screens.visual.HaloBackdropView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:haloCenterX="50%"
                        app:haloCenterY="50%"
                        app:haloInnerColor="@color/pw_hero_inner"
                        app:haloOuterColor="@color/pw_hero_outer"
                        app:haloOuterStop="0.75"
                        app:haloRadiusX="85%"
                        app:haloRadiusY="60%" />

                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.find.phone.gps.location.tracker.screens.visual.RingStrokeView
                            android:layout_width="216dp"
                            android:layout_height="216dp"
                            android:layout_gravity="center"
                            app:ringColor="@color/pw_ring_dashed"
                            app:ringDash="4.5dp"
                            app:ringGap="4.5dp"
                            app:ringWidth="1.5dp" />

                        <com.find.phone.gps.location.tracker.screens.visual.RingStrokeView
                            android:layout_width="172dp"
                            android:layout_height="172dp"
                            android:layout_gravity="center"
                            app:ringColor="@color/pw_ring_solid"
                            app:ringWidth="1.5dp" />

                        <com.find.phone.gps.location.tracker.screens.visual.CssShadowFrame
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            app:frameCorner="32dp"
                            app:frameRingColor="@color/so_icon_ring"
                            app:frameRingWidth="4dp"
                            app:frameShadowBlur="40dp"
                            app:frameShadowColor="@color/so_icon_shadow"
                            app:frameShadowDy="22dp"
                            app:frameShadowSpread="-16dp">

                            <com.find.phone.gps.location.tracker.screens.visual.RoundedArtView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/app_name"
                                app:artCorner="32dp"
                                app:artSrc="@mipmap/ic_launcher"
                                app:artZoom="1.08" />
                        </com.find.phone.gps.location.tracker.screens.visual.CssShadowFrame>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/vs_premium_fade" />

                    <com.find.phone.gps.location.tracker.screens.pro.DismissTimerView
                        android:id="@+id/padClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="14dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-40dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/vs_gold_pill"
                        android:fontFamily="@font/figtree_bold"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="@string/ds_premium_badge"
                        android:textColor="@color/ds_gold_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_extrabold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.95"
                        android:text="@string/ds_premium_title"
                        android:textColor="@color/ds_ink"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/figtree_medium"
                        android:text="@string/ds_premium_subtitle"
                        android:textColor="@color/ds_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <include
                        android:id="@+id/plan1Vw"
                        layout="@layout/card_premium_plan" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/plan2Vw"
                        layout="@layout/card_premium_plan" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/plan3Vw"
                        layout="@layout/card_premium_plan" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/lblFeature1"
                        style="@style/Ds.Text.PremiumCheck"
                        android:text="@string/ds_premium_feature_1" />

                    <TextView
                        android:id="@+id/lblFeature2"
                        style="@style/Ds.Text.PremiumCheck"
                        android:layout_marginTop="8dp"
                        android:text="@string/ds_premium_feature_2" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/footerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/lblPriceLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center"
                android:textColor="@color/ds_ink2"
                android:textSize="12sp"
                tools:text="$9.99/week after FREE 3-day trial" />

            <FrameLayout
                android:id="@+id/padContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/vs_btn_primary_selector_r18"
                android:elevation="6dp">

                <View
                    android:id="@+id/shineVw"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/vs_shine"
                    android:rotation="20"
                    android:scaleY="1.6" />

                <TextView
                    android:id="@+id/lblCta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/figtree_bold"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="Continue · $9.99 / week" />

                <ProgressBar
                    android:id="@+id/pbCtaVw"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/padContinueFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_semibold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/ds_premium_continue_free"
                android:textColor="@color/ds_ink2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/figtree_medium"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/ds_muted"
                android:textColorLink="@color/ds_primary"
                android:textSize="10.5sp"
                tools:text="By continuing you agree to our Terms &amp; Privacy. Auto-renews after trial; cancel anytime." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/padRestore"
                    style="@style/Ds.Text.PremiumLink"
                    android:text="@string/ds_premium_restore" />

                <TextView
                    android:id="@+id/padTerms"
                    style="@style/Ds.Text.PremiumLink"
                    android:layout_marginStart="6dp"
                    android:text="@string/ds_premium_terms" />

                <TextView
                    android:id="@+id/padPrivacy"
                    style="@style/Ds.Text.PremiumLink"
                    android:layout_marginStart="6dp"
                    android:text="@string/ds_premium_privacy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
