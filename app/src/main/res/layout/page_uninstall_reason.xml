<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <LinearLayout
        android:id="@+id/unRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Ds.Text.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/un_reason_title" />

                <TextView
                    style="@style/Un.FixSub"
                    android:layout_marginTop="4dp"
                    android:text="@string/un_reason_sub" />

                <LinearLayout
                    android:id="@+id/reasonListVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/vs_card_border_r18"
                    android:orientation="vertical"
                    android:padding="4dp" />

                <LinearLayout
                    android:id="@+id/tipCardVw"
                    style="@style/Un.FixCard"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/vs_row_selected_r14"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Un.Tile"
                        android:background="@drawable/vs_tile_amber_r12"
                        android:src="@drawable/ic_un_g_lightbulb"
                        app:tint="@color/ds_warn" />

                    <TextView
                        android:id="@+id/lblTip"
                        style="@style/Un.FixSub"
                        android:layout_width="0dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/ds_ink2" />

                    <TextView
                        android:id="@+id/padTip"
                        style="@style/Un.SmallButton" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="20dp" />

                <TextView
                    android:id="@+id/padKeepApp"
                    style="@style/Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:text="@string/un_keep_app" />

                <TextView
                    android:id="@+id/padUninstallAnyway"
                    style="@style/Ds.Text.Skip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/un_uninstall_anyway" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adNativeDividerVw"
            style="@style/AdDivider"
            android:background="@color/ds_hairline12" />

        <FrameLayout
            android:id="@+id/adNativeFrameVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmerVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/ad_g_native_mid" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
