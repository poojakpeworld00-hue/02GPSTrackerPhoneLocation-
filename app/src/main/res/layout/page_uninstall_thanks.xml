<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <LinearLayout
        android:id="@+id/unRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp">

                    <View
                        android:id="@+id/heartRingVw"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_un_ring" />

                    <FrameLayout
                        android:id="@+id/heartTileVw"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_un_disc"
                        android:elevation="6dp">

                        <ImageView
                            android:id="@+id/imgHeart"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_un_heart"
                            app:tint="@color/ds_danger" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/lblTitle"
                    style="@style/Ds.Text.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/un_thanks_title" />

                <TextView
                    android:id="@+id/lblSub"
                    style="@style/Un.FixSub"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/un_thanks_sub" />

                <TextView
                    android:id="@+id/lblSaid"
                    style="@style/Un.FixSub"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/vs_tile_gray_r12"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/ds_ink2" />

                <TextView
                    android:id="@+id/padContinue"
                    style="@style/Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="28dp"
                    android:text="@string/un_continue" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adNativeDividerVw"
            style="@style/AdDivider"
            android:background="@color/ds_hairline12" />

        <FrameLayout
            android:id="@+id/adNativeFrameVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmerVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/ad_g_native_mid" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
