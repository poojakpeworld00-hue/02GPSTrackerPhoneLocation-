<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRootVw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_page"
    android:clickable="true"
    android:focusable="true"
    tools:context=".screens.dashboard.DashboardMainFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/adBannerDividerVw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeContentVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:id="@+id/heroBoxVw"
                android:layout_width="0dp"
                android:layout_height="210dp"
                android:background="@drawable/hb_band"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/crest"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/padMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/hb_glass_r14"
                    android:contentDescription="@string/ds_cd_menu"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:src="@drawable/vs_ic_menu"
                    app:tint="@color/hb_on_band" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_extrabold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/ds_home_title"
                    android:textColor="@color/hb_on_band"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/padHistory"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/hb_glass_r14"
                    android:contentDescription="@string/ds_cd_history"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:src="@drawable/vs_ic_history"
                    app:tint="@color/hb_on_band" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/nunito_extrabold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/ds_home_headline"
                android:textColor="@color/hb_on_band"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/crest" />

            <LinearLayout
                android:id="@+id/searchCardVw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/hb_card_r24"
                android:clipChildren="false"
                android:elevation="14dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="@color/hb_shadow"
                android:outlineSpotShadowColor="@color/hb_shadow"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblHeadline"
                tools:targetApi="p">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/fieldHaloVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="-4dp"
                        android:background="@drawable/vs_field_halo_r20"
                        android:visibility="invisible" />

                    <LinearLayout
                        android:id="@+id/phoneFieldVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hb_field_r16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <LinearLayout
                            android:id="@+id/countryChipVw"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/hb_country_r12"
                            android:clickable="true"
                            android:contentDescription="@string/ds_cd_country"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/lblFlag"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/hb_circle_blue"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textSize="13sp"
                                tools:text="🇮🇳" />

                            <TextView
                                android:id="@+id/lblDial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/figtree_bold"
                                android:textColor="@color/hb_ink"
                                android:textSize="14sp"
                                tools:text="+91" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/vs_ic_chevron_down"
                                app:tint="@color/hb_muted" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/phoneInputVw"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/figtree_semibold"
                            android:fontFeatureSettings="tnum"
                            android:hint="@string/ds_enter_phone"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/hb_ink"
                            android:textColorHint="@color/ds_placeholder"
                            android:textSize="17sp" />

                        <ImageButton
                            android:id="@+id/padContact"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/hb_contact_r12"
                            android:contentDescription="@string/ds_cd_contacts"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:scaleType="center"
                            android:src="@drawable/vs_ic_contacts"
                            app:tint="@color/hb_primary" />

                        <ImageButton
                            android:id="@+id/padClear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/ds_cd_clear"
                            android:scaleType="center"
                            android:src="@drawable/vs_ic_close"
                            android:visibility="gone"
                            app:tint="@color/hb_muted" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="false">

                        <View
                            android:id="@+id/searchGlowVw"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/vs_glow_radial"
                            android:visibility="invisible" />

                        <LinearLayout
                            android:id="@+id/padSearch"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/hb_btn_primary_r16"
                            android:clickable="true"
                            android:elevation="6dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:outlineAmbientShadowColor="@color/hb_primary"
                            android:outlineSpotShadowColor="@color/hb_primary"
                            tools:targetApi="p">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/vs_ic_search_bold"
                                app:tint="@color/hb_on_band" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/figtree_bold"
                                android:text="@string/ds_search_location"
                                android:textColor="@color/hb_on_band"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/quotaRowVw"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp">

                        <LinearLayout
                            android:id="@+id/quotaTileVw"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/hb_quota_r16"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblQuota"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:includeFontPadding="false"
                                android:textColor="@color/hb_amber_ink"
                                android:textSize="16sp"
                                tools:text="2/3" />

                            <ProgressBar
                                android:id="@+id/quotaBarVw"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:max="100"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/myNumberHomeVw"
                layout="@layout/part_home_my_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchCardVw" />

            <FrameLayout
                android:id="@+id/adNativeCardVw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hb_ad_card_r22"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/myNumberHomeVw">

                <FrameLayout
                    android:id="@+id/adNativeFrameVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmerVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/ad_g_native_mid" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/lblRecentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/nunito_extrabold"
                android:paddingBottom="10dp"
                android:text="@string/ds_recent_searches"
                android:textColor="@color/hb_ink"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adNativeCardVw" />

            <TextView
                android:id="@+id/padClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/figtree_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:text="@string/ds_clear_all"
                android:textColor="@color/hb_primary"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintBaseline_toBaselineOf="@id/lblRecentTitle"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/emptyStateVw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/vs_dashed_card_r20"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblRecentTitle">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/hb_circle_blue">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/vs_ic_pin"
                        app:tint="@color/hb_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/ds_no_searches"
                        android:textColor="@color/hb_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_medium"
                        android:lineSpacingMultiplier="1.4"
                        android:text="@string/ds_no_searches_sub"
                        android:textColor="@color/hb_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rollRecents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblRecentTitle"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/adBannerDividerVw"
        style="@style/AdDivider"
        android:layout_width="0dp"
        android:background="@color/hb_border"
        app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        layout="@layout/part_bottom_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
