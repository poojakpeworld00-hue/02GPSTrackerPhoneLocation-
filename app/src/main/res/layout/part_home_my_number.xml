<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/my_number_title"
            android:textColor="@color/hb_ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/padManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:text="@string/my_number_manage"
            android:textColor="@color/hb_primary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/promptCardVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/hb_sim_card_r20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/lblMyNumberSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/my_number_sub"
            android:textColor="@color/hb_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/padMyNumber"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/hb_show_blue_r12"
            android:foreground="?attr/selectableItemBackground"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/my_number_show"
            android:textColor="@color/hb_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/simRowsVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:divider="@drawable/hb_gap_10"
        android:orientation="horizontal"
        android:showDividers="middle"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
