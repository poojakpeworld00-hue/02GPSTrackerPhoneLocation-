<?xml version="1.0" encoding="utf-8"?>

<resources>
    <declare-styleable name="MeshBackdropView">
        <attr name="gridColor" format="color" />
        <attr name="gridSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="PulseHaloView">
        <attr name="pingColor" format="color" />
        <attr name="pingStrokeWidth" format="dimension" />
        <attr name="pingFillColor" format="color" />
        <attr name="pingDuration" format="integer" />
        <attr name="pingDelay" format="integer" />
    </declare-styleable>

    <declare-styleable name="ScannerBeamView">
        <attr name="sweepColor" format="color" />
        <attr name="sweepAngle" format="float" />
        <attr name="sweepDuration" format="integer" />
    </declare-styleable>

    <declare-styleable name="MarkerOutlineView">
        <attr name="pinStartColor" format="color" />
        <attr name="pinEndColor" format="color" />
        <attr name="pinDotColor" format="color" />
        <attr name="pinDotSize" format="dimension" />
        <attr name="pinShadowColor" format="color" />
        <attr name="pinBorderColor" format="color" />
        <attr name="pinBorderWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="StreetLinesView">
        <attr name="roadsVariant" format="enum">
            <enum name="splash" value="0" />
            <enum name="homeHero" value="1" />
            <enum name="map" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="TypewriterLabel">
        <attr name="typingText" format="string" />
        <attr name="typingDuration" format="integer" />
    </declare-styleable>

    <declare-styleable name="HaloBackdropView">
        <attr name="haloCenterX" format="fraction" />
        <attr name="haloCenterY" format="fraction" />
        <attr name="haloRadiusX" format="fraction" />
        <attr name="haloRadiusY" format="fraction" />
        <attr name="haloInnerColor" format="color" />
        <attr name="haloOuterColor" format="color" />
        <attr name="haloOuterStop" format="float" />
    </declare-styleable>

    <declare-styleable name="RingStrokeView">
        <attr name="ringColor" format="color" />
        <attr name="ringWidth" format="dimension" />
        <attr name="ringDash" format="dimension" />
        <attr name="ringGap" format="dimension" />
        <attr name="ringInset" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SweepArcRingView">
        <attr name="arcColor" format="color" />
        <attr name="arcPeakAlpha" format="float" />
        <attr name="arcPeakAt" format="float" />
        <attr name="arcEndAt" format="float" />
        <attr name="arcThickness" format="fraction" />
    </declare-styleable>

    <declare-styleable name="CssShadowFrame">
        <attr name="frameCorner" format="dimension" />
        <attr name="frameOval" format="boolean" />
        <attr name="frameFill" format="color" />
        <attr name="frameClipContent" format="boolean" />
        <attr name="frameShadowColor" format="color" />
        <attr name="frameShadowDy" format="dimension" />
        <attr name="frameShadowBlur" format="dimension" />
        <attr name="frameShadowSpread" format="dimension" />
        <attr name="frameRingColor" format="color" />
        <attr name="frameRingWidth" format="dimension" />
    </declare-styleable>
    <declare-styleable name="RoundedArtView">
        <attr name="artSrc" format="reference" />
        <attr name="artCorner" format="dimension" />
        <attr name="artZoom" format="float" />
    </declare-styleable>
</resources>
