<?xml version="1.0" encoding="utf-8"?>
<!-- Uninstall funnel (screens/uninstall), built on the Ds.* design system. -->
<resources>

    <style name="Un.FixCard" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/vs_card_border_r18</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Un.Tile" parent="android:Widget">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Un.FixTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Un.FixSub" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Un.SmallButton" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/vs_btn_primary_selector_r14</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Un.StepRow" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Un.StepText" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
