<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_holderView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/status_scrimView"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/hdk_status_scrim" />

    <include
        android:id="@+id/default_launcher_bannerView"
        layout="@layout/hdk_default_launcher_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/home_screen_gridView"
        layout="@layout/hdk_home_screen_grid" />

    <include
        android:id="@+id/all_apps_fragmentView"
        layout="@layout/hdk_all_apps_fragment"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_fragmentView"
        layout="@layout/hdk_widgets_fragment"
        android:visibility="gone" />

    <include
        android:id="@+id/left_panelView"
        layout="@layout/hdk_left_panel_fragment"
        android:visibility="gone" />

    <include
        android:id="@+id/host_panelView"
        layout="@layout/hdk_host_panel"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/swipe_hintView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#be000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/swipe_hint_chevronsView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/swipe_hint_chevron_1View"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.3"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/swipe_hint_chevron_2View"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/swipe_hint_chevron_3View"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/swipe_hint_labelView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/launcher_swipe_right_hint"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="@string/launcher_swipe_hint_tap"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/home_screen_popup_menu_anchorView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
